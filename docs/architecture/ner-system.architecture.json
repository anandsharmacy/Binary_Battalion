  "meta": {
    "title": "NER System Architecture",
    "quality_profile": "showcase",
    "visual_preset": "signal-flow",
    "viewBox": [
      1380,
      780
    ],
    "views": [
      {
        "id": "deep-website",
        "label": "Deep Dive: Website Architecture",
        "focus": [
          "web_ui",
          "web_state",
          "web_api",
          "gw_route"
        ],
        "note": "Pages render from the global store; the API client adds auth headers, caches responses, and calls the gateway."
      },
      {
        "id": "deep-flutter",
        "label": "Deep Dive: Flutter App Architecture",
        "focus": [
          "fl_ui",
          "fl_state",
          "fl_local",
          "fl_net",
          "gw_route"
        ],
        "note": "Widgets read BLoC/Riverpod state; state persists to Hive/SQLite and calls the gateway through Dio with an auth interceptor."
      },
      {
        "id": "deep-gateway",
        "label": "Deep Dive: API Gateway & Backend",
        "focus": [
          "gw_route",
          "gw_auth",
          "gw_logic",
          "gw_dal",
          "ml_api",
          "db_pool"
        ],
        "note": "Requests pass routing, then JWT/rate-limit/CORS checks, then controllers that call the DB layer or proxy to ML."
      },
      {
        "id": "deep-ml",
        "label": "Deep Dive: ML Inference Engine",
        "focus": [
          "ml_api",
          "ml_cache",
          "ml_pre",
          "ml_rt",
          "db_pool"
        ],
        "note": "The wrapper checks the inference cache, else preprocesses features, runs the model, and logs predictions to the DB."
      },
      {
        "id": "deep-db",
        "label": "Deep Dive: Shared Database & Schemas",
        "focus": [
          "db_pool",
          "db_engine",
          "db_schema",
          "gw_dal",
          "ml_rt"
        ],
        "note": "Gateway and ML writes share one pool and executor, one engine, and one set of shared schemas."
      }
    ]
  },
